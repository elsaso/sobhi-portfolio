{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pubDate": {
      "type": "string",
      "format": "date-time"
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "live": {
      "type": "string"
    },
    "image": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        }
      },
      "required": [
        "url",
        "alt"
      ]
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "pubDate",
    "title",
    "subtitle",
    "live",
    "image"
  ]
}