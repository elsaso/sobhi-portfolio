---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectCard2 from "@/components/projects/ProjectCard2.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout
  title="Software Projects | Sobhi El-Safady"
  description="Industrial software, embedded systems, mobile applications, SaaS products, and data-driven tools built by Sobhi El-Safady."
>
  <section>
    <div class="mx-auto max-w-6xl px-6 py-24 sm:px-10">
      <div class="max-w-3xl">
        <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-holo-300">
          Archive // {String(projects.length).padStart(2, "0")} dossiers
        </p>
        <h1 class="mt-5 text-balance text-4xl font-medium leading-[0.95] tracking-[-0.03em] text-white sm:text-5xl lg:text-6xl">
          Software built for{" "}
          <span class="font-display italic tracking-normal text-white/50">
            real products and operations.
          </span>
        </h1>
        <p class="mt-6 max-w-2xl text-balance text-lg leading-8 text-white/55">
          Industrial tools, embedded systems, mobile products, and SaaS platforms.
          Each case study explains the context, my contribution, and the result.
        </p>
      </div>

      <div class="mt-12 grid gap-4">
        {projects.map((project) => <ProjectCard2 post={project} />)}
      </div>
    </div>
  </section>
</BaseLayout>
