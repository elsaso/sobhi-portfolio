---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectCard2 from "@/components/projects/ProjectCard2.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout
  title="Software Projects | Sobhi El-Safady"
  description="Industrial software, embedded systems, mobile applications, SaaS products, and data-driven tools built by Sobhi El-Safady."
>
  <section>
    <div class="mx-auto max-w-3xl px-8 py-24">
      <div class="text-center">
        <h1 class="text-balance text-4xl font-medium tracking-tight text-base-900 sm:text-5xl lg:text-6xl dark:text-white">
          Software built for
          <span class="font-display italic tracking-wide text-base-600 dark:text-base-400">
            real products and operations.
          </span>
        </h1>
        <p class="mx-auto mt-5 max-w-2xl text-balance text-lg leading-8 text-base-600 dark:text-base-400">
          Industrial tools, embedded systems, mobile products, and SaaS platforms.
          Each case study explains the context, my contribution, and the result.
        </p>
      </div>

      <div class="mt-10 flex flex-col gap-3">
        {projects.map((project) => <ProjectCard2 post={project} />)}
      </div>
    </div>
  </section>
</BaseLayout>
