---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found | Sobhi El-Safady"
  description="The page you requested could not be found."
  noindex
>
  <section>
    <div class="mx-auto flex min-h-[65svh] max-w-3xl items-center justify-center px-8 py-24 text-center">
      <div>
        <p class="text-sm text-base-500 dark:text-base-400">404 error</p>
        <h1 class="mt-5 text-balance text-4xl font-medium tracking-tight text-base-900 sm:text-5xl dark:text-white">
          This page has
          <span class="font-display italic tracking-wide text-base-600 dark:text-base-400">left the building.</span>
        </h1>
        <p class="mx-auto mt-5 max-w-lg text-base leading-7 text-base-600 dark:text-base-400">
          The address may be incomplete, or the page may have moved.
        </p>
        <a
          href="/"
          class="mt-8 inline-flex h-10 items-center rounded-full bg-base-900 px-5 text-sm font-medium text-white transition-transform duration-150 active:scale-[0.97] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-500 dark:bg-base-100 dark:text-base-950"
        >
          Back to portfolio
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
