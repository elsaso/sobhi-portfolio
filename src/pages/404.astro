---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found | Sobhi El-Safady"
  description="The page you requested could not be found."
  noindex
>
  <section>
    <div class="mx-auto flex min-h-[65svh] max-w-3xl items-center justify-center px-8 py-24 text-center">
      <div>
        <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-holo-300">404 // signal lost</p>
        <h1 class="mt-5 text-balance text-4xl font-medium tracking-tight text-white sm:text-5xl">
          This page has{" "}
          <span class="font-display italic tracking-normal text-white/50">left the building.</span>
        </h1>
        <p class="mx-auto mt-5 max-w-lg text-base leading-7 text-white/55">
          The address may be incomplete, or the page may have moved.
        </p>
        <a
          href="/"
          class="mt-8 inline-flex h-11 items-center bg-white px-6 text-sm font-medium text-black transition-transform duration-150 active:scale-[0.97] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-holo-400"
        >
          Back to portfolio
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
