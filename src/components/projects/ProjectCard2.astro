---
import { Image } from "astro:assets";

const { post } = Astro.props;
const url = `/projects/${post.id}`;
const { title, subtitle, role, logo } = post.data;
---

<article class="flaco-card group relative grid overflow-hidden rounded-3xl p-2 shadow ring-1 ring-base-200 ring-inset transition-[transform,box-shadow] duration-200 ease-out hover:shadow-light sm:grid-cols-2 dark:ring-base-800 dark:hover:shadow-dark">
  <a
    href={url}
    class="absolute inset-0 z-10 rounded-3xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-500"
    aria-label={`View ${title} case study`}
  ></a>

  <div class="flex min-h-72 flex-col justify-between p-5 sm:p-6">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 class="text-base font-medium uppercase tracking-wide text-base-900 dark:text-white">
          {title}
        </h2>
        <p class="mt-2 text-xs text-base-500 dark:text-base-400">{role}</p>
      </div>
      <span class="grid size-8 shrink-0 place-items-center rounded-full bg-base-950 text-white transition-transform duration-200 ease-out group-hover:-rotate-45 dark:bg-base-50 dark:text-base-900">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" class="size-4">
          <path d="M12 5v14M5 12h14"></path>
        </svg>
      </span>
    </div>

    <div class="mt-12">
      <p class="text-balance text-base leading-7 text-base-600 dark:text-base-400">{subtitle}</p>
      <span class="mt-7 inline-flex items-center gap-2 text-sm font-medium text-base-900 dark:text-white">
        Read more <span aria-hidden="true">→</span>
      </span>
    </div>
  </div>

  <div class="order-first overflow-hidden rounded-2xl bg-base-100 sm:order-last dark:bg-base-900">
    <Image
      src={logo.url}
      alt={logo.alt}
      width={700}
      height={700}
      class="aspect-square h-full w-full object-cover transition-transform duration-300 ease-out motion-safe:group-hover:scale-[1.025]"
    />
  </div>
</article>
