---
const { post } = Astro.props;
const url = `/projects/${post.id}`;
const { title, subtitle, role, period, industry, technologies, logo } = post.data;
---

<article class="flaco-card group relative grid overflow-hidden border border-line/70 transition-[transform,border-color] duration-300 ease-out hover:-translate-y-0.5 hover:border-holo-400/40 sm:grid-cols-[1.2fr_1fr]">
  <a
    href={url}
    class="absolute inset-0 z-10 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-holo-400"
    aria-label={`View ${title} case study`}
  ></a>

  <div class="flex min-h-64 flex-col justify-between p-6 sm:p-7">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="font-mono text-[9px] uppercase tracking-[0.2em] text-holo-300/90">{industry}</p>
        <h2 class="mt-2.5 text-lg font-medium uppercase tracking-wide text-white">{title}</h2>
        <p class="mt-1.5 font-mono text-[10px] uppercase tracking-[0.18em] text-white/40">
          {role} · {period}
        </p>
      </div>
      <span
        class="grid size-9 shrink-0 place-items-center border border-line text-white/70 transition-[transform,border-color,color] duration-200 ease-out group-hover:-rotate-45 group-hover:border-holo-400/60 group-hover:text-holo-300"
        aria-hidden="true"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-4">
          <path d="M12 5v14M5 12h14"></path>
        </svg>
      </span>
    </div>

    <div class="mt-10">
      <p class="text-balance text-sm leading-6 text-white/60">{subtitle}</p>
      <ul class="mt-5 flex flex-wrap gap-x-3 gap-y-1 font-mono text-[10px] tracking-[0.1em] text-white/45" aria-label="Core technologies">
        {technologies.slice(0, 4).map((technology) => <li>{technology}</li>)}
      </ul>
      <span class="mt-6 inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.18em] text-holo-300/90">
        Open dossier{" "}
        <span aria-hidden="true" class="inline-block transition-transform duration-200 group-hover:translate-x-1">→</span>
      </span>
    </div>
  </div>

  <div class="relative order-first overflow-hidden border-b border-line/70 bg-panel/40 sm:order-last sm:border-b-0 sm:border-l">
    <img
      src={logo.url.src}
      alt={logo.alt}
      width={700}
      height={700}
      class="aspect-square h-full w-full object-cover opacity-90 saturate-[0.82] transition-[transform,opacity,filter] duration-500 ease-out group-hover:scale-[1.03] group-hover:opacity-100 group-hover:saturate-100"
    />
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-void/60 via-transparent to-transparent"></div>
  </div>
</article>
