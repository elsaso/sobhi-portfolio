---
const { post, wide = false } = Astro.props;
const url = `/projects/${post.id}`;
const { title, subtitle, industry, role, period, technologies, highlights, image } = post.data;
---

<article
  class:list={[
    "flaco-card group relative flex flex-col overflow-hidden border border-line/70 transition-[transform,border-color,box-shadow] duration-300 ease-out hover:-translate-y-1 hover:border-holo-400/40",
    wide && "md:col-span-2",
  ]}
>
  <a
    href={url}
    class="absolute inset-0 z-10 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-holo-400"
    aria-label={`View ${title} case study`}
  ></a>

  <div class="relative overflow-hidden border-b border-line/70">
    <img
      src={image.url.src}
      alt={image.alt}
      width={1200}
      height={675}
      loading="eager"
      fetchpriority={wide ? "high" : "auto"}
      class="aspect-[16/7] w-full object-cover opacity-90 saturate-[0.82] transition-[transform,opacity,filter] duration-500 ease-out group-hover:scale-[1.03] group-hover:opacity-100 group-hover:saturate-100"
    />
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-void/85 via-transparent to-void/25"></div>
    <p class="absolute left-4 top-4 border border-line/70 bg-void/70 px-2 py-1 font-mono text-[9px] uppercase tracking-[0.2em] text-holo-300 backdrop-blur-md">
      {industry}
    </p>
  </div>

  <div class="flex grow flex-col p-6 sm:p-7">
    <div class="flex items-start justify-between gap-4">
      <h3 class="text-lg font-medium uppercase tracking-wide text-white">{title}</h3>
      <span
        class="grid size-9 shrink-0 place-items-center border border-line text-white/70 transition-[transform,border-color,color] duration-200 ease-out group-hover:-rotate-45 group-hover:border-holo-400/60 group-hover:text-holo-300"
        aria-hidden="true"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-4">
          <path d="M12 5v14M5 12h14"></path>
        </svg>
      </span>
    </div>

    <p class="mt-1.5 font-mono text-[10px] uppercase tracking-[0.18em] text-white/40">
      {role} · {period}
    </p>

    <p class="mt-4 max-w-xl text-balance text-sm leading-6 text-white/60">{subtitle}</p>

    <p class="mt-4 flex gap-2.5 text-sm leading-6 text-white/75">
      <span class="mt-[9px] size-1.5 shrink-0 rounded-full bg-signal" aria-hidden="true"></span>
      {highlights[0]}
    </p>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-line/60 pt-4">
      <ul class="flex flex-wrap gap-x-3 gap-y-1 font-mono text-[10px] tracking-[0.1em] text-white/45" aria-label="Core technologies">
        {technologies.slice(0, 4).map((technology) => <li>{technology}</li>)}
      </ul>
      <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-holo-300/90">
        Open dossier{" "}
        <span aria-hidden="true" class="inline-block transition-transform duration-200 group-hover:translate-x-1">→</span>
      </span>
    </div>
  </div>
</article>
