---
import ProjectCard1 from "@/components/projects/ProjectCard1.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects"))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<section id="work">
  <div class="mx-auto max-w-3xl px-8 py-14 sm:py-20">
    <div class="flex items-end justify-between gap-6">
      <div>
        <p class="text-xs uppercase tracking-[0.14em] text-base-500 dark:text-base-400">
          Manufacturing, products, and systems
        </p>
        <h2 class="mt-2 font-display text-4xl italic tracking-wide text-base-900 dark:text-white">
          Selected work
        </h2>
      </div>
      <a
        href="/projects/"
        class="shrink-0 rounded-full bg-base-200 px-4 py-2 text-xs font-medium text-base-950 transition-[transform,background-color] duration-150 hover:bg-base-100 active:scale-[0.97] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-500 dark:bg-base-900 dark:text-white dark:hover:bg-base-800"
      >
        See all projects
      </a>
    </div>

    <div class="mt-7 grid gap-3 md:grid-cols-2">
      {
        projects.map((project, index) => (
          <ProjectCard1 post={project} wide={index === projects.length - 1} />
        ))
      }
    </div>
  </div>
</section>
