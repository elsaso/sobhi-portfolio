---
const experience = [
  {
    period: "Apr 2026 – Present",
    company: "Vortex Health Analytics",
    role: "Software & Data Engineer",
    description:
      "Builds ingestion, normalization, validation, and analytics workflows across fragmented clinical, operational, and billing systems.",
    current: true,
  },
  {
    period: "Oct 2023 – Present",
    company: "LEDEX",
    role: "Technical Project Manager, Software & Automation",
    description:
      "Owns software and process-automation delivery for hazardous-location products, industrial lighting, quoting, procurement, and assembly workflows.",
    current: true,
  },
  {
    period: "Jul 2022 – Present",
    company: "Polaire Labs",
    role: "Co-Founder & Lead Software Engineer",
    description:
      "Leads architecture and delivery for mobile applications, streaming platforms, SaaS products, APIs, integrations, and cloud deployments.",
    current: true,
  },
  {
    period: "2022 & 2023",
    company: "TelcoBridges",
    role: "Software Engineer Intern",
    description:
      "Developed embedded C/C++ features in carrier-grade telephony systems and maintained Jenkins-driven system tests and CI/CD tooling.",
    current: false,
  },
  {
    period: "Sep – Dec 2021",
    company: "Pratt & Whitney Canada",
    role: "Software Engineer Intern",
    description:
      "Delivered application features for aircraft-engine QA specifications, PLM workflows, engineering documents, testing, and releases.",
    current: false,
  },
  {
    period: "Jan 2020 – Sep 2021",
    company: "Witlaken",
    role: "Software Developer",
    description:
      "Built Java ERP, MES, PLM, accounting, and healthcare modules with Python automation, SQL workflows, REST APIs, and CAD integrations.",
    current: false,
  },
  {
    period: "Feb 2016 – Jan 2020",
    company: "Dialexia",
    role: "Junior Software Developer",
    description:
      "Implemented RFC-based SIP functionality, WebRTC and PBX services, an Android softphone, provisioning tools, QA, and production troubleshooting.",
    current: false,
  },
];
---

<section id="experience" class="border-t border-line/70">
  <div class="mx-auto max-w-6xl px-6 py-20 sm:px-10 sm:py-28">
    <div class="grid gap-6 lg:grid-cols-[1fr_2fr] lg:gap-20">
      <div>
        <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-holo-300">
          03 // service record
        </p>
        <h2 class="mt-5 text-balance text-4xl font-medium leading-[0.95] tracking-[-0.03em] text-white sm:text-5xl">
          Ten years of engineering,{" "}
          <span class="font-display italic tracking-normal text-white/50">close to the operation.</span>
        </h2>
        <p class="mt-6 max-w-sm text-base leading-7 text-white/55">
          From protocol stacks and embedded systems to ERP workflows, mobile
          products, and data platforms.
        </p>
      </div>

      <ol class="relative border-l border-line/70">
        {
          experience.map((item, index) => (
            <li class="relative pb-10 pl-8 last:pb-0">
              <span
                class:list={[
                  "absolute -left-[5px] top-1.5 size-2.5 rounded-full border",
                  item.current
                    ? "border-signal bg-signal/30 shadow-[0_0_10px_rgba(132,204,22,.6)]"
                    : "border-line bg-panel",
                ]}
                aria-hidden="true"
              ></span>
              <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/40">
                  LOG-{String(experience.length - index).padStart(2, "0")}
                  {item.current && <span class="ml-3 text-signal">Active</span>}
                </p>
                <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-white/40">
                  {item.period}
                </p>
              </div>
              <h3 class="mt-3 text-lg font-medium text-white">{item.company}</h3>
              <p class="mt-1 font-mono text-[11px] uppercase tracking-[0.14em] text-holo-300/80">
                {item.role}
              </p>
              <p class="mt-3 max-w-xl text-sm leading-6 text-white/55">
                {item.description}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
