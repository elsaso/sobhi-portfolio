    <div class="pointer-events-none absolute bottom-5 left-1/2 z-20 -translate-x-1/2 text-center sm:hidden">
      <p class="font-mono text-[9px] uppercase tracking-[0.2em] text-white/45">Scroll to traverse</p>
      <span class="mx-auto mt-2 block h-8 w-px bg-gradient-to-b from-[#7dd3fc] to-transparent"></span>
    </div>
  </div>
