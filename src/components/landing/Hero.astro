<style>
  .hero-vignette {
    background:
      radial-gradient(circle at center, transparent 20%, rgba(2, 7, 16, 0.12) 54%, rgba(2, 7, 16, 0.92) 100%),
      linear-gradient(to bottom, rgba(2, 7, 16, 0.08), transparent 35%, rgba(2, 7, 16, 0.48));
  }

  .hero-grid {
    background-image: radial-gradient(rgba(184, 229, 255, .18) .6px, transparent .6px);
    background-size: 28px 28px;
    mask-image: radial-gradient(circle at center, black, transparent 78%);
  }

  .ring-fallback {
    background: radial-gradient(circle at 50% 44%, rgba(38, 157, 220, .1), transparent 38%), #020710;
    transition: opacity 450ms cubic-bezier(0.23, 1, 0.32, 1);
    will-change: opacity;
  }

  .hero-stage {
    will-change: opacity, transform, filter;
  }

  .hero-copy {
    text-shadow: 0 2px 28px rgba(2, 7, 16, 0.78);
  }

  .hero-final-copy {
    text-shadow: 0 2px 24px rgba(2, 7, 16, 0.9);
  }

  .hero-final-copy::before {
    position: absolute;
    z-index: -1;
    inset: -5rem -7rem;
    content: "";
    background: radial-gradient(ellipse at center, rgba(2, 7, 16, .9) 0 24%, rgba(2, 7, 16, .64) 48%, transparent 72%);
  }

  @media (prefers-reduced-motion: reduce) {
    .cinematic-hero {
      height: 100svh;
    }

    .hero-stage:not([data-stage="0"]) {
      display: none;
    }
  }
</style>

<script>
  const section = document.getElementById("cinematic-hero");
  const canvas = document.getElementById("systems-canvas");
  const fallback = document.getElementById("webgl-fallback");

  if (section instanceof HTMLElement && canvas instanceof HTMLCanvasElement) {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const coarsePointer = window.matchMedia("(pointer: coarse)").matches;
    const compact = coarsePointer || window.innerWidth < 720;
    const stages = [...section.querySelectorAll(".hero-stage")];
    const progressBar = document.getElementById("hero-progress");
    const percent = document.getElementById("hero-percent");
    const range = document.getElementById("hero-range");
    const altitude = document.getElementById("hero-altitude");
    const phase = document.getElementById("hero-phase");
    const ranges = [
      [-0.08, 0.27],
      [0.2, 0.5],
      [0.44, 0.76],
      [0.7, 1.08],
    ];

    let ringScene;
    let targetProgress = 0;
    let sceneActive = true;
    const sceneModule = import("@/scripts/ringworld-scene");

    const clamp = (value, min, max) => Math.min(Math.max(value, min), max);
    const rangeOpacity = (progress, start, end) => {
      const fade = 0.075;
      return clamp(Math.min((progress - start) / fade, (end - progress) / fade), 0, 1);
    };

    const updateStages = (progress) => {
      stages.forEach((stage, index) => {
        if (!(stage instanceof HTMLElement)) return;
        const opacity = rangeOpacity(progress, ranges[index][0], ranges[index][1]);
        stage.style.opacity = String(opacity);
        stage.style.transform = `translate3d(0, ${(1 - opacity) * 18}px, 0)`;
        stage.style.filter = `blur(${(1 - opacity) * 2}px)`;
        stage.style.pointerEvents = opacity > 0.55 ? "auto" : "none";
      });
    };

    const updateTelemetry = ({ progress, rangeKm, altitudeKm, phase: traversalPhase }) => {
      if (progressBar instanceof HTMLElement) {
        progressBar.style.transform = `scaleX(${progress})`;
      }
      if (percent) percent.textContent = String(Math.round(progress * 100)).padStart(3, "0");
      if (range) range.textContent = `RNG ${rangeKm.toFixed(1).padStart(4, "0")} KM`;
      if (altitude) altitude.textContent = `ALT ${altitudeKm.toFixed(1).padStart(4, "0")} KM`;
      if (phase) phase.textContent = traversalPhase;
    };

    const updateFallback = (progress) => {
      const value = reducedMotion ? 0 : progress;
      const phaseName =
        value < 0.2
          ? "ORBITAL REVEAL"
          : value < 0.45
            ? "RIM APPROACH"
            : value < 0.72
              ? "RING INSERTION"
              : "INTERIOR VECTOR";
      updateStages(value);
      updateTelemetry({
        progress: value,
        rangeKm: 0.8 + Math.pow(1 - value, 1.55) * 63.2,
        altitudeKm: 0.55 + Math.pow(1 - value, 1.2) * 17.95,
        phase: phaseName,
      });
    };

    const updateScroll = () => {
      if (reducedMotion) {
        targetProgress = 0;
      } else {
        const rect = section.getBoundingClientRect();
        const travel = Math.max(section.offsetHeight - window.innerHeight, 1);
        targetProgress = clamp(-rect.top / travel, 0, 1);
      }
      updateStages(targetProgress);

      if (ringScene) {
        ringScene.setProgress(targetProgress);
      } else {
        updateFallback(targetProgress);
      }
    };

    const resize = () => {
      ringScene?.resize(window.innerWidth, window.innerHeight);
    };

    const pointerMove = (event) => {
      if (!ringScene || compact || reducedMotion) return;
      ringScene.setPointer(
        (event.clientX / window.innerWidth - 0.5) * 2,
        (event.clientY / window.innerHeight - 0.5) * 2,
      );
    };

    const observer = new IntersectionObserver(
      ([entry]) => {
        sceneActive = entry.isIntersecting;
        ringScene?.setActive(sceneActive);
      },
      { rootMargin: "20% 0px" },
    );
    observer.observe(section);

    window.addEventListener("scroll", updateScroll, { passive: true });
    window.addEventListener("resize", resize, { passive: true });
    if (!compact && !reducedMotion) {
      window.addEventListener("pointermove", pointerMove, { passive: true });
    }

    updateScroll();

    const initializeScene = async () => {
      try {
        const { createRingworldScene } = await sceneModule;
        ringScene = createRingworldScene(canvas, {
          compact,
          reducedMotion,
          onFrame: updateTelemetry,
          onReady: () => {
            if (fallback instanceof HTMLElement) fallback.style.opacity = "0";
          },
        });
        ringScene.setActive(sceneActive);
        ringScene.setProgress(targetProgress);
      } catch {
        if (fallback instanceof HTMLElement) fallback.style.opacity = "1";
        updateFallback(targetProgress);
      }
    };

    let sceneFrame = window.requestAnimationFrame(() => {
      sceneFrame = window.requestAnimationFrame(initializeScene);
    });

    window.addEventListener(
      "pagehide",
      () => {
        window.cancelAnimationFrame(sceneFrame);
        observer.disconnect();
        window.removeEventListener("scroll", updateScroll);
        window.removeEventListener("resize", resize);
        window.removeEventListener("pointermove", pointerMove);
        ringScene?.destroy();
      },
      { once: true },
    );
  }
</script>
