---
const isHome = Astro.url.pathname === "/";
const anchor = (id: string) => (isHome ? `#${id}` : `/#${id}`);

const links = [
  { text: "Home", href: "/" },
  { text: "Selected work", href: "/projects/" },
  { text: "Experience", href: anchor("experience") },
  { text: "Capabilities", href: anchor("capabilities") },
  { text: "Résumé", href: "/Sobhi-El-Safady-Resume.pdf", download: true },
  { text: "Get in touch", href: "mailto:sobhi.safady@gmail.com" },
];
---

<header class:list={[isHome && "absolute inset-x-0 top-0 z-40 text-white"]}>
  <nav
    aria-label="Primary navigation"
    class="mx-auto grid w-full max-w-3xl grid-cols-2 items-center gap-4 px-8 py-4"
  >
    <a
      href="/"
      class:list={[
        "w-fit rounded-sm font-display text-2xl italic tracking-wide focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-500",
        isHome ? "text-white" : "text-base-900 dark:text-white",
      ]}
    >
      Sobhi
    </a>

    <div class="flex items-center justify-end gap-3">
      <a
        href="/Sobhi-El-Safady-Resume.pdf"
        download
        class:list={[
          "text-sm transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-500",
          isHome
            ? "text-white/60 hover:text-white"
            : "text-base-500 hover:text-base-900 dark:text-base-400 dark:hover:text-white",
        ]}
      >
        Résumé
      </a>
      <button
        type="button"
        id="menu-toggle"
        aria-controls="menu"
        aria-expanded="false"
        aria-label="Open menu"
        class:list={[
          "grid size-9 place-items-center rounded-full transition-transform duration-150 active:scale-[0.97] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-500",
          isHome ? "text-white" : "text-base-900 dark:text-white",
        ]}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" class="size-5">
          <path d="M4 8h16M4 16h16"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div
    id="menu"
    aria-hidden="true"
    inert
    class="pointer-events-none fixed inset-0 z-50 bg-white/80 opacity-0 backdrop-blur-2xl transition-opacity duration-200 ease-out dark:bg-base-950/85"
  >
    <div class="mx-auto flex h-full max-w-3xl flex-col px-8 py-4">
      <button
        type="button"
        id="menu-close"
        aria-label="Close menu"
        class="ml-auto grid size-9 place-items-center rounded-full text-base-900 transition-transform duration-150 active:scale-[0.97] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-500 dark:text-white"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" class="size-5">
          <path d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>

      <div class="my-auto flex flex-col items-end gap-2 py-12">
        {
          links.map((link) => (
            <a
              href={link.href}
              download={link.download}
              class="menu-link translate-y-2 rounded-sm font-display text-4xl italic tracking-wide text-base-900 opacity-0 transition-[opacity,transform,color] duration-200 ease-out hover:text-base-500 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-500 sm:text-5xl dark:text-white dark:hover:text-base-400"
            >
              {link.text}
            </a>
          ))
        }
      </div>

      <p class="text-right text-sm text-base-500 dark:text-base-400">
        Software & data engineer · Mississauga, Ontario
      </p>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const close = document.getElementById("menu-close");
  const menu = document.getElementById("menu");
  const links = menu?.querySelectorAll(".menu-link") ?? [];

  const setMenu = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    menu.setAttribute("aria-hidden", String(!open));
    menu.toggleAttribute("inert", !open);
    menu.classList.toggle("pointer-events-none", !open);
    menu.classList.toggle("opacity-0", !open);
    document.body.classList.toggle("overflow-hidden", open);

    links.forEach((link, index) => {
      window.setTimeout(() => {
        link.classList.toggle("translate-y-2", !open);
        link.classList.toggle("opacity-0", !open);
      }, open ? index * 45 : 0);
    });

    if (open) window.setTimeout(() => close?.focus(), 80);
  };

  toggle?.addEventListener("click", () => setMenu(true));
  close?.addEventListener("click", () => setMenu(false));
  links.forEach((link) => link.addEventListener("click", () => setMenu(false)));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      setMenu(false);
      toggle.focus();
    }
  });
</script>
