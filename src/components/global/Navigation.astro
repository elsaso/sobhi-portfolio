---
const isHome = Astro.url.pathname === "/";
const anchor = (id: string) => (isHome ? `#${id}` : `/#${id}`);

const links = [
  { text: "Home", href: "/", id: "00" },
  { text: "Selected work", href: "/projects/", id: "01" },
  { text: "Experience", href: anchor("experience"), id: "02" },
  { text: "Capabilities", href: anchor("capabilities"), id: "03" },
  { text: "Contact", href: anchor("contact"), id: "04" },
  { text: "Résumé", href: "/Sobhi-El-Safady-Resume.pdf", id: "05", download: true },
];
---

<header class:list={[isHome && "absolute inset-x-0 top-0 z-40 text-white"]}>
  <nav
    aria-label="Primary navigation"
    class="mx-auto grid w-full max-w-6xl grid-cols-2 items-center gap-4 border-b border-line/60 px-6 py-4 sm:px-10"
  >
    <a
      href="/"
      class="w-fit rounded-sm font-display text-2xl italic tracking-wide text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-holo-400"
    >
      Sobhi
    </a>

    <div class="flex items-center justify-end gap-5">
      <a
        href="/Sobhi-El-Safady-Resume.pdf"
        download
        class="hidden font-mono text-[10px] uppercase tracking-[0.22em] text-white/55 transition-colors duration-150 hover:text-holo-300 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-holo-400 sm:block"
      >
        Résumé ↓
      </a>
      <button
        type="button"
        id="menu-toggle"
        aria-controls="menu"
        aria-expanded="false"
        aria-label="Open menu"
        class="grid size-10 place-items-center border border-line bg-panel/40 text-white backdrop-blur-md transition-[transform,border-color] duration-150 hover:border-holo-400/50 active:scale-[0.97] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-holo-400"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="size-5">
          <path d="M4 8h16M4 16h16"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div
    id="menu"
    aria-hidden="true"
    inert
    class="pointer-events-none fixed inset-0 z-50 bg-void/90 opacity-0 backdrop-blur-2xl transition-opacity duration-200 ease-out"
  >
    <div class="mx-auto flex h-full max-w-6xl flex-col px-6 py-4 sm:px-10">
      <div class="flex items-center justify-between border-b border-line/60 pb-4">
        <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-white/40">
          Navigation // El-Safady systems
        </p>
        <button
          type="button"
          id="menu-close"
          aria-label="Close menu"
          class="grid size-10 place-items-center border border-line bg-panel/40 text-white transition-[transform,border-color] duration-150 hover:border-holo-400/50 active:scale-[0.97] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-holo-400"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="size-5">
            <path d="M6 6l12 12M18 6 6 18"></path>
          </svg>
        </button>
      </div>

      <nav aria-label="Menu" class="my-auto flex flex-col items-start gap-3 py-12">
        {
          links.map((link) => (
            <a
              href={link.href}
              download={link.download}
              class="menu-link group flex translate-y-2 items-baseline gap-4 rounded-sm opacity-0 transition-[opacity,transform] duration-200 ease-out focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-holo-400"
            >
              <span class="font-mono text-[10px] tracking-[0.2em] text-holo-400/70">{link.id}</span>
              <span class="font-display text-4xl italic tracking-wide text-white transition-colors duration-150 group-hover:text-holo-300 sm:text-6xl">
                {link.text}
              </span>
            </a>
          ))
        }
      </nav>

      <div class="flex flex-wrap items-center justify-between gap-3 border-t border-line/60 pt-4">
        <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/40">
          Software & data engineer · Mississauga, Ontario
        </p>
        <p class="flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.2em] text-signal">
          <span class="size-1.5 rounded-full bg-signal shadow-[0_0_10px_#84cc16]"></span>
          Available / 2026
        </p>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const close = document.getElementById("menu-close");
  const menu = document.getElementById("menu");
  const links = menu?.querySelectorAll(".menu-link") ?? [];

  const setMenu = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    menu.setAttribute("aria-hidden", String(!open));
    menu.toggleAttribute("inert", !open);
    menu.classList.toggle("pointer-events-none", !open);
    menu.classList.toggle("opacity-0", !open);
    document.body.classList.toggle("overflow-hidden", open);

    links.forEach((link, index) => {
      window.setTimeout(() => {
        link.classList.toggle("translate-y-2", !open);
        link.classList.toggle("opacity-0", !open);
      }, open ? index * 45 : 0);
    });

    if (open) window.setTimeout(() => close?.focus(), 80);
  };

  toggle?.addEventListener("click", () => setMenu(true));
  close?.addEventListener("click", () => setMenu(false));
  links.forEach((link) => link.addEventListener("click", () => setMenu(false)));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      setMenu(false);
      toggle.focus();
    }
  });
</script>
