---
// Foundations
import "@/styles/global.css";
import BaseHead from "@/components/fundations/head/BaseHead.astro";
// Components
import Footer from "@/components/global/Footer.astro";
import Navigation from "@/components/global/Navigation.astro";
import Search from "@/components/global/Search.astro";
import ThemeToggle from "@/components/assets/ThemeToggle.astro";
---

<html lang="en" class="antialiased">
  <head>
    <BaseHead />
  </head>
  <body
    class="flex flex-col bg-white min-h-svh dark:bg-base-950 transition-colors duration-300"
  >
    <ThemeToggle class="" aria-label="Toggle theme" />
    <Search />
    <Navigation />
    <main class="relative grow"><slot /></main>
    <Footer />
  </body>
</html>
