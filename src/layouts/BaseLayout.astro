---
import "@/styles/global.css";
import BaseHead from "@/components/fundations/head/BaseHead.astro";
import Footer from "@/components/global/Footer.astro";
import Navigation from "@/components/global/Navigation.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown>;
}

const {
  title = "Sobhi El-Safady | Software & Data Engineer",
  description = "Software and data engineer building embedded systems, industrial applications, ERP and automation software for teams.",
  image = "/og/sobhi-el-safady.png",
  noindex,
  structuredData,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="antialiased">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      noindex={noindex}
      structuredData={structuredData}
    />
  </head>
  <body class="flex min-h-svh flex-col bg-void text-white">
    <a
      href="#main-content"
      class="sr-only z-[100] rounded-md bg-holo-400 px-4 py-2 text-sm font-semibold text-void focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
    >
      Skip to content
    </a>
    <Navigation />
    <main id="main-content" class="relative grow"><slot /></main>
    <Footer />
  </body>
</html>
